{
	"name": "blog-shirone-preview",
	"installCommand": "npx --yes --package=node@26.13.0 --package=pnpm@11.28.2 -- pnpm install --frozen-lockfile",
	"buildCommand": "npx --yes --package=node@26.13.0 --package=pnpm@11.28.2 -- pnpm anime:sync --provider bilibili && npx --yes --package=node@26.13.0 --package=pnpm@11.28.2 -- pnpm build",
	"assets": {
		"directory": "./dist",
		"notFoundStrategy": "404Page"
	}
}
